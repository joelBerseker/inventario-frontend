{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Permisos principales",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "http://127.0.0.1:8001/**"
        },
        {
          "url": "http://localhost:8001/**"
        }
      ]
    }
  ]
}
